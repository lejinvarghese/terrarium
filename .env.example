# Terrarium Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys
# =============================================================================

# Weather (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key

# OpenAI (for embeddings and optional LLM access)
OPENAI_API_KEY=your_openai_api_key

# Image Generation (get from https://runware.ai/)
RUNWARE_API_KEY=your_runware_api_key

# Web Search (get from https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# Google Services
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Recipe API (get from https://spoonacular.com/food-api)
SPOONACULAR_API_KEY=your_spoonacular_api_key

# GitHub (for repo access)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token

# =============================================================================
# Telegram Bot Configuration
# =============================================================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token

# Your Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id

# Additional users' chat IDs (optional)
# DANIELLE_TELEGRAM_CHAT_ID=another_chat_id

# Telegram API credentials for userbot features (optional)
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_SESSION_STRING=your_session_string

# =============================================================================
# Spotify Integration (Optional)
# =============================================================================

# Get from https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# =============================================================================
# Service Paths
# =============================================================================

# ComfyUI installation directory (defaults to ~/projects/ComfyUI)
# COMFYUI_PATH=/path/to/your/ComfyUI

# NPM global bin directory (defaults to ~/.npm-global/bin)
# NPM_BIN_PATH=/path/to/.npm-global/bin

# Hugging Face cache directory (optional)
# HF_CACHE=/path/to/huggingface/cache

# =============================================================================
# Cloudflare Tunnel (Optional)
# =============================================================================

# Set to "true" to use named tunnel, "false" for quick tunnels
# USE_NAMED_TUNNEL=false

# If using named tunnel, specify your domain
# TUNNEL_DOMAIN=your-tunnel-domain.com

# =============================================================================
# Multi-User Configuration
# =============================================================================

# For multi-user setups, manage users via src/configs/users.json
# See docs/MULTI_USER_IMPLEMENTATION.md for details
